# Razorpay Backend Environment Configuration
# Copy this file to .env and add your actual credentials

# Server Configuration
PORT=3000
NODE_ENV=development

# Razorpay Credentials (get from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXX
RAZORPAY_KEY_SECRET=your_secret_key_here

# Razorpay Webhook Secret (get from Dashboard > Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# API Key for Flutter app authentication (optional)
API_KEY=your_api_key_here
